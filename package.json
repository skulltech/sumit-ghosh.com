{
  "name": "sumit-ghosh-com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build:cloudflare && cf deploy --prebuilt",
    "build:cloudflare": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build && wrangler build --experimental-new-config --experimental-cf-build-output"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "cf": "^1.0.0-beta.25",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
