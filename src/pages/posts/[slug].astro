---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const description = post.data.description ?? `${post.data.title} — notes by Sumit Ghosh.`;
---
<Base title={post.data.title} description={description} articleDate={post.data.date}>
  <article>
    <header class="page-header article-header">
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="deck">{post.data.description}</p>}
      <p class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post)} min read</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
  <div class="article-footer"><a href="/writing/">← All writing</a><a href="mailto:sumit@sumit-ghosh.com">Reply by email</a></div>
</Base>
